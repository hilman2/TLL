  <!-- Traffic control logic without any game or Unity dependency.
       The mod compiles these sources into its own assembly (see src/TLL/TLL.csproj);
       this project exists so the logic can be built and tested on its own. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>TLL.Core</RootNamespace>
  </PropertyGroup>

</Project>
